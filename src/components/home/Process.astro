---
import { section, field, list } from '../../lib/home';
const s = section('PROCESS');
const steps = list(s, 'Steps');
---
<section id={s.id} class="section">
  <div class="container">
    <header class="section-head">
      <span class="rule"></span>
      <span class="kicker">{field(s, 'Kicker')}</span>
      <h2 class="h2">{field(s, 'H2')}</h2>
    </header>

    <ol role="list" class="steps">
      {steps.map((step, i) => (
        <li>
          <span class="n" aria-hidden="true">{String(step.n ?? i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }
  li { border-top: 1px solid var(--stone-300); padding-top: 1.5rem; }
  .n { display: block; font-family: var(--font-serif); font-style: italic; font-size: clamp(2.75rem, 6vw, 3.75rem); line-height: 1; color: var(--stone-900); }
  .n::after { content: ''; display: block; width: 2rem; height: 3px; background: var(--gold-400); margin-top: 1rem; }
  h3 { margin-top: 1.25rem; font-family: var(--font-serif); font-weight: 400; font-size: 1.375rem; color: var(--stone-900); }
  p { margin-top: 0.75rem; font-size: 0.9375rem; color: var(--stone-600); }
  @media (max-width: 479.98px) { .steps { gap: 2rem 1rem; } p { font-size: 0.875rem; } }
</style>
