---
import { section, field, list } from '../../lib/home';
const s = section('MATERIALS');
const cards = list(s, 'Cards');
---
<section id={s.id} class="section section--white">
  <div class="container">
    <header class="section-head section-head--center">
      <span class="rule" style="margin-inline:auto"></span>
      <span class="kicker">{field(s, 'Kicker')}</span>
      <h2 class="h2">{field(s, 'H2')}</h2>
      <p class="lede">{field(s, 'Intro')}</p>
    </header>

    <ul role="list" class="cards">
      {cards.map((c, i) => (
        <li class="card">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          {c.link?.href && (
            <a class="link-underline" href={c.link.href}>
              Learn more<span class="sr-only"> about {c.title.toLowerCase()}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards { display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cards { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .card { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: 2.5rem 2rem 2.25rem; background: var(--stone-50); border: 1px solid var(--stone-200); transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s; }
  .card:hover { border-color: var(--stone-300); box-shadow: 0 20px 40px -24px rgb(28 26 25 / 0.35); transform: translateY(-2px); }
  .num { font-family: var(--font-serif); font-style: italic; font-size: 0.9375rem; color: var(--stone-600); padding-bottom: 0.4rem; border-bottom: 2px solid var(--gold-400); margin-bottom: 1.5rem; }
  h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.5rem; color: var(--stone-900); }
  p { margin: 0.9rem 0 1.75rem; font-size: 0.9375rem; color: var(--stone-600); flex: 1; }
</style>
