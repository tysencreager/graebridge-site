---
import T from '../T.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { section, field, list, emph } from '../../lib/home';
import { altFor } from '../../lib/content';

const s = section('ABOUT');
const stats = list(s, 'Stats');
const features = list(s, 'Feature list');
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/about.{jpg,jpeg,png,webp}', { eager: true });
const image = Object.values(files)[0]?.default;
const teamFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/team.{jpg,jpeg,png,webp}', { eager: true });
const team = Object.values(teamFiles)[0]?.default;
---
<section id={s.id} class="section about">
  <div class="container grid">
    <div class:list={['media', { 'media--pair': !!team }]}>
      <div class="frame main">
        {image ? (
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1000].filter((w) => w <= image.width)}
            sizes="(min-width: 1024px) 28rem, 72vw"
            alt={altFor('about.jpg', 'Members of the Graebridge Stone family')}
            loading="lazy"
          />
        ) : (
          <div class="image-coming" style="aspect-ratio: 4 / 5">Image coming</div>
        )}
      </div>
      {team && (
        <div class="second">
          <Picture
            src={team}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1000].filter((w) => w <= team.width)}
            sizes="(min-width: 1024px) 24rem, 62vw"
            alt={altFor('team.jpg', 'The Graebridge Stone shop team')}
            loading="lazy"
          />
        </div>
      )}
    </div>

    <div class="copy">
      <span class="rule"></span>
      <span class="kicker">{field(s, 'Kicker')}</span>
      <h2 class="h2" set:html={emph(field(s, 'H2'))} />
      <p><T text={field(s, 'P1')} /></p>
      <p><T text={field(s, 'P2')} /></p>

      <dl class="stats">
        {stats.map((st) => (
          <div>
            <dt><T text={st.body} /></dt>
            <dd>{st.title}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="container">
    <ul role="list" class="features">
      {features.map((f) => (
        <li>
          <h3><T text={f.title} /></h3>
          <p><T text={f.body} /></p>
        </li>
      ))}
    </ul>
    <p class="assoc">{field(s, 'Associations line')}</p>
  </div>
</section>

<style>
  .grid { display: grid; gap: 3.5rem; align-items: center; }
  .grid > * { min-width: 0; }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .media { padding: 1rem 0 0 1rem; }
  .media :global(img) { width: 100%; height: auto; }
  /* Two photos: the portrait sits in the mockup frame, the team photo overlaps its lower right corner */
  .media--pair .main { width: 76%; }
  .media--pair .main :global(img) { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 35%; }
  .second { position: relative; z-index: 2; width: 64%; margin: -24% 0 0 auto; border: 0.5rem solid var(--stone-50); box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.3); }
  .second :global(img) { display: block; aspect-ratio: 4 / 3; object-fit: cover; }
  .h2 :global(em) { display: block; }
  .copy p { color: var(--stone-600); margin-top: 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--stone-200); }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .stats dd { font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.25rem); line-height: 1.1; color: var(--stone-900); }
  .stats dt { margin-top: 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone-600); line-height: 1.5; }
  /* Narrow phones: three columns of tracked capitals do not fit, so each stat becomes a row */
  @media (max-width: 479.98px) {
    .stats { grid-template-columns: 1fr; gap: 1rem; }
    .stats div { flex-direction: row-reverse; justify-content: flex-end; align-items: baseline; gap: 1rem; }
    .stats dd { flex: none; min-width: 5.5rem; }
    .stats dt { margin-top: 0; }
  }
  .features { display: grid; margin-top: clamp(3.5rem, 7vw, 6rem); border-block: 1px solid var(--stone-200); }
  .features li { padding: 2rem 0; }
  .features li + li { border-top: 1px solid var(--stone-200); }
  .features h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.375rem; color: var(--stone-900); }
  .features p { margin-top: 0.6rem; font-size: 0.9375rem; color: var(--stone-600); }
  @media (min-width: 768px) {
    .features { grid-template-columns: repeat(3, 1fr); text-align: center; }
    .features li { padding: 2.5rem 2rem; }
    .features li + li { border-top: 0; border-left: 1px solid var(--stone-200); }
  }
  .assoc { margin-top: 1.75rem; text-align: center; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--stone-600); }
</style>
