---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { section, field, list, emph } from '../../lib/home';

const s = section('ABOUT');
const stats = list(s, 'Stats');
const features = list(s, 'Feature list');
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/about.{jpg,jpeg,png,webp}', { eager: true });
const image = Object.values(files)[0]?.default;
---
<section id={s.id} class="section about">
  <div class="container grid">
    <div class="media">
      <div class="frame">
        {image ? (
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[480, 720, 960].filter((w) => w <= image.width)}
            sizes="(min-width: 1024px) 38rem, 92vw"
            alt="A member of the Graebridge Stone team leaning on a polished grey-veined stone island in a white kitchen"
            loading="lazy"
          />
        ) : (
          <div class="image-coming" style="aspect-ratio: 4 / 3">Image coming</div>
        )}
      </div>
    </div>

    <div class="copy">
      <span class="rule"></span>
      <span class="kicker">{field(s, 'Kicker')}</span>
      <h2 class="h2" set:html={emph(field(s, 'H2'))} />
      <p>{field(s, 'P1')}</p>
      <p>{field(s, 'P2')}</p>

      <dl class="stats">
        {stats.map((st) => (
          <div>
            <dt>{st.body}</dt>
            <dd>{st.title}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="container">
    <ul role="list" class="features">
      {features.map((f) => (
        <li>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
    <p class="assoc">{field(s, 'Associations line')}</p>
  </div>
</section>

<style>
  .grid { display: grid; gap: 3.5rem; align-items: center; }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .media { padding: 1rem 0 0 1rem; }
  .media :global(img) { width: 100%; height: auto; }
  .h2 :global(em) { display: block; }
  .copy p { color: var(--stone-600); margin-top: 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--stone-200); }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .stats dd { font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.25rem); line-height: 1.1; color: var(--stone-900); }
  .stats dt { margin-top: 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone-600); line-height: 1.5; }
  .features { display: grid; margin-top: clamp(3.5rem, 7vw, 6rem); border-block: 1px solid var(--stone-200); }
  .features li { padding: 2rem 0; }
  .features li + li { border-top: 1px solid var(--stone-200); }
  .features h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.375rem; color: var(--stone-900); }
  .features p { margin-top: 0.6rem; font-size: 0.9375rem; color: var(--stone-600); }
  @media (min-width: 768px) {
    .features { grid-template-columns: repeat(3, 1fr); text-align: center; }
    .features li { padding: 2.5rem 2rem; }
    .features li + li { border-top: 0; border-left: 1px solid var(--stone-200); }
  }
  .assoc { margin-top: 1.75rem; text-align: center; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--stone-600); }
</style>
