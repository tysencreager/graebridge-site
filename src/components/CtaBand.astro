---
// Contact band above the footer on inner pages. Heading copy is reused from the CONTACT section of home.md.
import Icon from './Icon.astro';
import { section, field } from '../lib/home';
import { site, telHref, smsHref } from '../lib/site';
const s = section('CONTACT');
---
<section class="cta section--dark" aria-labelledby="cta-heading">
  <div class="container inner">
    <div>
      <span class="kicker">{field(s, 'Kicker')}</span>
      <h2 class="h2" id="cta-heading">{field(s, 'H2')}</h2>
    </div>
    <div class="actions">
      <a class="contact" href={telHref} data-event="call_click" data-label="cta band">
        <Icon name="phone" size={18} /><span><small>Call</small>{site.phoneDisplay}</span>
      </a>
      <a class="contact" href={smsHref} data-event="text_click" data-label="cta band">
        <Icon name="text" size={18} /><span><small>Text</small>{site.phoneDisplay}</span>
      </a>
      <a class="btn btn--gold" href="/#contact">Request a free estimate</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2.5rem 4rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.5rem; }
  .contact { display: inline-flex; align-items: center; gap: 0.85rem; color: var(--white); text-decoration: none; font-size: 1.125rem; }
  .contact :global(svg) { color: var(--gold-400); }
  .contact span { display: flex; flex-direction: column; line-height: 1.3; }
  .contact small { font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone-400); }
  .contact:hover { color: var(--gold-400); }
  @media (max-width: 639.98px) { .actions { width: 100%; } .actions .btn { width: 100%; } }
</style>
