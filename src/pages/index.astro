  path="/"
  isHome
  jsonld={[localBusiness(), faqPage()]}
>
  <Hero />
  <Trust />
  <About />
  <Materials />
  <Services />
  <Porcelain />
  <Process />
  <Gallery />
  <Reviews />
  <Instagram />
