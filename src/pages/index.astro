import Trust from '../components/home/Trust.astro';
import About from '../components/home/About.astro';
import Materials from '../components/home/Materials.astro';
import Services from '../components/home/Services.astro';
import Porcelain from '../components/home/Porcelain.astro';
import Process from '../components/home/Process.astro';
import Gallery from '../components/home/Gallery.astro';
import Reviews from '../components/home/Reviews.astro';
import Instagram from '../components/home/Instagram.astro';
import Faq from '../components/home/Faq.astro';
