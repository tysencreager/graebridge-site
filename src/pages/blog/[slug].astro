---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { livePosts, postPath, formatDate } from '../../lib/blog';
import WorkStrip from '../../components/WorkStrip.astro';
import { proseHtml, firstSentence, splitIntro } from '../../lib/prose';
import { pagePhotos } from '../../lib/photos';
import { breadcrumbs } from '../../lib/schema';
import { site, canonical } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await livePosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}

const { entry, posts } = Astro.props;
const { data } = entry;
const path = postPath(entry);
const description = data.description || firstSentence(entry.body ?? '');
const [introHtml, restHtml] = splitIntro(proseHtml(entry.rendered?.html ?? '', data.title));
const photos = pagePhotos('blog', entry.id);
const more = posts.filter((p) => p.id !== entry.id).slice(0, 3);
const iso = data.date.toISOString().slice(0, 10);

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description,
  datePublished: iso,
  author: { '@type': 'Organization', name: data.author, url: site.domain + '/' },
  publisher: { '@id': `${site.domain}/#business` },
  mainEntityOfPage: canonical(path),
  image: canonical('/images/og-graebridge-stone.jpg'),
};
const crumbs = breadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: data.title, path },
]);
---
<Base title={data.title} description={description} path={path} ogType="article" jsonld={[article, crumbs]}>
  <PageHero kicker="Blog" title={data.title} crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: 'Article' }]} photo={photos.hero} />

  <article class="section post">
    <div class="container">
      <p class="meta">By {data.author} · <time datetime={iso}>{formatDate(data.date)}</time></p>
      {introHtml && <div class="prose" set:html={introHtml} />}
      <WorkStrip photos={photos.work} />
      <div class="prose" set:html={restHtml} />
    </div>
  </article>

  {more.length > 0 && (
    <aside class="more" aria-labelledby="more-heading">
      <div class="container">
        <h2 id="more-heading" class="kicker">More from the blog</h2>
        <ul role="list">
          {more.map((p) => (
            <li>
              <a href={postPath(p)}>
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
                <span>{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )}

  <CtaBand />
</Base>

<style>
  .post { background: var(--white); padding-block: clamp(3rem, 6vw, 5rem); }
  .meta { margin-bottom: 2.5rem; padding-bottom: 1.5rem; max-width: 46rem; border-bottom: 1px solid var(--stone-200); font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone-600); }
  .more { background: var(--stone-100); border-block: 1px solid var(--stone-200); padding-block: 3.5rem; }
  .more ul { display: grid; gap: 1.5rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .more ul { grid-template-columns: repeat(3, 1fr); } }
  .more a { display: flex; flex-direction: column; gap: 0.75rem; height: 100%; padding: 1.75rem; background: var(--white); border: 1px solid var(--stone-200); text-decoration: none; transition: border-color 0.3s; }
  .more a:hover { border-color: var(--gold-400); }
  .more time { font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone-600); }
  .more span { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.3; color: var(--stone-900); }
</style>
